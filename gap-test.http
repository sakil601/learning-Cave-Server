### যদি quiz না থাকে expected:
###
### {
###   "success": true,
###   "data": null
### }


### =========================================================
### EXISTING
### CREATE QUIZ
### যদি module এ quiz না থাকে
### =========================================================

PATCH {{baseUrl}}/admin/quizzes/6aaaf9c27f289f20f398b8bc
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Module 1 Quiz Updated",
  "passPercentage": 85,
  "showCorrectAnswer": true
}


### =========================================================
### EXISTING
### GET QUIZ BY QUIZ ID
### =========================================================

GET {{baseUrl}}/admin/quizzes/{{quizId}}
Authorization: Bearer {{adminToken}}


### =========================================================
### NEW GAP API 11
### UPDATE QUIZ
### =========================================================

PATCH {{baseUrl}}/admin/quizzes/{{quizId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Updated Module Quiz",
  "required": true,
  "showResult": true,
  "showCorrectAnswer": true,
  "randomizeQuestions": false,
  "active": true
}


### Another quiz update test
PATCH {{baseUrl}}/admin/quizzes/{{quizId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "passPercentage": 100
}


### =========================================================
### EXISTING
### ADD TRUE/FALSE QUESTION
### =========================================================

POST {{baseUrl}}/admin/quizzes/{{quizId}}/questions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "question": "Microsoft Excel is a spreadsheet application.",
  "correctAnswer": true,
  "marks": 1,
  "order": 1
}


### Add another question
POST {{baseUrl}}/admin/quizzes/{{quizId}}/questions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "question": "Excel files cannot contain formulas.",
  "correctAnswer": false,
  "marks": 1,
  "order": 2
}

