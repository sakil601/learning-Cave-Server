### =========================================================
### NEW GAP API 1
### STUDENT ORDER HISTORY
### GET /orders/me
### =========================================================

GET {{baseUrl}}/orders/me
Authorization: Bearer {{studentToken}}

### single orders
GET {{baseUrl}}/orders/me/6abef63229946e1e3d902aef
Authorization: Bearer {{studentToken}}


### Pagination
GET {{baseUrl}}/orders/me?page=1&limit=10
Authorization: Bearer {{studentToken}}


### Filter by order status
GET {{baseUrl}}/orders/me?status=pending
Authorization: Bearer {{studentToken}}


### Filter by payment status
GET {{baseUrl}}/orders/me?paymentStatus=paid
Authorization: Bearer {{studentToken}}


### Paid orders
GET {{baseUrl}}/orders/me?page=1&limit=20&paymentStatus=paid
Authorization: Bearer {{studentToken}}


### =========================================================
### NEW GAP API 2
### STUDENT SINGLE ORDER
### GET /orders/me/:id
### =========================================================



GET {{baseUrl}}/orders/me/{{orderId}}
Authorization: Bearer {{studentToken}}



### 1) LIVE COURSE PRODUCT CREATE
POST {{baseUrl}}/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "type": "live_course",
  "title": "Excel Live Course",
  "slug": "excel-live-course",
  "shortDescription": "Live Microsoft Excel course",
  "description": "Learn Microsoft Excel through live classes.",
  "categories": [],
  "tags": ["excel", "live"],
  "regularPrice": 2000,
  "salePrice": 1500,
  "isFree": false,
  "access": {
    "type": "lifetime"
  }
}

